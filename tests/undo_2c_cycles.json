["/* 1.29.2c C : affichage seul */\nfunction cycSt(i){var c=cal().cycles[i],t=todayStr();return !c||c.bad||!c.start?'':c.end&&t>c.end?'done':t>=c.start?'cur':'next';}\nfunction dmyS(s){var p=s.split('-');return p[2]+'/'+p[1]+'<span class=\"cy-y\">/'+p[0]+'</span>';}\nfunction cycTile(i,p){var s=cycSt(i);return '<button class=\"pchip cyt '+s+(i===p?' on':'')+'\" style=\"--c:var(--cy'+i%6+')\" data-p=\"'+i+'\" role=\"tab\" aria-selected=\"'+(i===p)+'\"><span class=\"pc-t\"><span class=\"pc-i\">'+cycEmoji(i)+'</span>'+esc(cycleName(i))+'</span><span class=\"pc-s\">'+({cur:'En cours',done:'Terminé',next:'À venir'}[s]||'')+'</span></button>';}\nfunction cycleInfoHtml(cid,p){\n","function cycleInfoHtml(cid,p){\n"]]