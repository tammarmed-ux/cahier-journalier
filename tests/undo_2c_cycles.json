[[".pchip.on{background:var(--pri);color:#fff;border-color:var(--pri)}\n.pchips .cyt{position:relative;display:inline-flex;flex-direction:column;align-items:flex-start;min-height:48px;padding:5px 12px 9px;border-radius:14px;border-color:var(--line);background:var(--card);color:var(--ink);line-height:1.15}.cyt:after{content:\"\";position:absolute;left:10px;right:10px;bottom:4px;height:3px;border-radius:3px;background:var(--c)}.pc-t{display:flex;align-items:center;gap:5px;font-size:13.5px;font-weight:750}.pc-i .act-pi{width:16px;height:16px}.pc-s{font-size:10.5px;color:var(--muted)}.cur .pc-s,.cy-l1>b{color:color-mix(in srgb,var(--c) 80%,var(--ink))}.cur .pc-s:before{content:\"● \"}.done .pc-s:before{content:\"✓ \"}.pchips .pchip.cyt.on{border-color:var(--c);background:color-mix(in srgb,var(--c) 14%,var(--card));color:var(--ink);box-shadow:inset 0 0 0 1px var(--c)}.cyt.on:after{height:4px}\n.cy-l1{display:flex;align-items:center;gap:6px;white-space:nowrap}.cy-l1>b{overflow:hidden;text-overflow:ellipsis}.cy-l1>.muted{flex:none}.pc-tag{flex:none;font-size:11px;font-weight:750;color:var(--card);background:var(--c);border-radius:9px;padding:2px 8px}\n@media (max-width:599px){.cy-l1{font-size:13px;gap:5px}.pc-tag{font-size:0;width:9px;height:9px;padding:0}.cy-y{display:none}}\n",".pchip.on{background:var(--pri);color:#fff;border-color:var(--pri)}\n"],
